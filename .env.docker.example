# 服务器 Docker 部署用的环境变量模板：
#   cp .env.docker.example .env   然后按需修改（.env 在 .gitignore 里，key 不进 git）
# compose 会自动读取本目录的 .env，注入到 backend 容器。
# 注意：这份是给 `docker compose` 用的；本机开发（uvicorn 直接起）读的是 backend/.env，
# 两份互不影响，别混。

# ---- 对外端口 ----
# 浏览器访问 http://<服务器IP>:8080。改这里即可，无需动 compose。
ZY_HTTP_PORT=8080

# ---- 构建镜像源（国内服务器拉包慢时打开，只影响 build）----
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# NPM_REGISTRY=https://registry.npmmirror.com

# ---- LLM 网关（不配也能跑：搜索/浏览/反馈/复核全部正常，
#      只是 AI 摘要落回规则式、向量召回降级、问答与缺口底稿返回「暂不可用」）----

# chat：任何 OpenAI 兼容端点。留空 API key = 内网免鉴权网关模式（不带 Authorization 头）。
# 网关就跑在这台服务器上的话，别写 localhost（那是容器自己）——写
# http://host.docker.internal:9000/v1，compose 里已经配好这个主机名的映射。
ZY_LLM_GATEWAY_URL=https://api.deepseek.com/v1
ZY_LLM_MODEL=deepseek-v4-flash
ZY_LLM_API_KEY=

# embedding：可以和 chat 不是同一家（DeepSeek 不提供 embedding）。留空 = 跟随 chat 网关。
# 维度钉死 1024 —— pgvector 的列是 vector(1024)。换维度必须重建 vec 列（新迁移）并
# `docker compose exec backend python scripts/reindex.py --embeddings --force` 全量回填。
ZY_EMBEDDING_GATEWAY_URL=https://api.siliconflow.cn/v1
ZY_EMBEDDING_API_KEY=
ZY_EMBEDDING_MODEL=BAAI/bge-m3

# ---- Git webhook（M4 自动更新闭环）----
# 接 GitHub/GitLab webhook 就必须改成随机串，并在对端填同一个值
ZY_WEBHOOK_SECRET=change-me

# ---- 首次启动行为 ----
# 1 = 库为空时自动导入 18 条示例资产 + 4 条缺口（已有数据自动跳过）；正式库置 0
ZY_AUTO_SEED=1

# ---- 连外部 PostgreSQL 时才需要（默认用 compose 内置的 pgvector 容器，不要填这一项）----
# 外部库必须装 pgvector 扩展，否则向量召回降级为 Python 余弦（功能不缺，只是没 ANN 加速）。
# 填了它之后用 `docker compose up -d --no-deps backend frontend` 起（--no-deps 必须带：
# backend 的 depends_on 会连带把内置 db 也拉起来）。
# ZY_DATABASE_URL=postgresql+psycopg://user:pass@10.0.0.5:5432/zhiyuan
