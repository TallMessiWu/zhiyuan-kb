# 复制为 .env 使用；前缀 ZY_
ZY_DATABASE_URL=postgresql+psycopg://zhiyuan:zhiyuan_dev@localhost:5433/zhiyuan
ZY_LLM_GATEWAY_URL=http://localhost:9000/v1
ZY_LLM_MODEL=internal-chat
# API key 留空 = 内网免鉴权网关。填了就带 Authorization: Bearer 头 ——
# 任何 OpenAI 兼容公有云（DeepSeek / SiliconFlow …）都能直接接。
ZY_LLM_API_KEY=
# embedding 可以走与 chat 不同的网关（例：chat 用 DeepSeek、embedding 用 SiliconFlow
# 的 BAAI/bge-m3 —— DeepSeek 不提供 embedding）。留空 = 跟随主网关。
ZY_EMBEDDING_GATEWAY_URL=
ZY_EMBEDDING_API_KEY=
ZY_EMBEDDING_MODEL=bge-m3
# 维度钉死 1024：pgvector 的 vec 列是 vector(1024)。公有云要选 bge-m3 兼容端点
# （如 SiliconFlow 的 BAAI/bge-m3）。换维度必须重建 vec 列（新迁移）并
# `python scripts/reindex.py --embeddings --force` 全量回填，别只改这里。
ZY_EMBEDDING_DIM=1024
ZY_WEBHOOK_SECRET=change-me

# 检索（M2）
ZY_RECALL_LIMIT=50
ZY_RRF_K=10
# auto = 探测可用性，用不了就自动降级；on = 强依赖（配错要报错）；off = 关闭
ZY_VECTOR_SEARCH=auto
ZY_AI_SUMMARY=auto
# 检索路径超时要短（只有查询 embedding 用它）：一次抖动别拖垮整页搜索。
# 生成路径（摘要/草稿/问答/底稿）用 GENERATION_TIMEOUT —— 公有云生成普遍 10–25s，
# 拿检索超时去卡会频繁超时→熔断，连带把别的生成一起降级掉（M5 实测踩过）。
ZY_LLM_TIMEOUT=6
ZY_GENERATION_TIMEOUT=60
ZY_LLM_CIRCUIT_SECONDS=60

# 问答（M5）：rel 阈值与上下文条数见 docs/design.md §6 落地注记
ZY_ASK_MIN_REL=5.0
ZY_ASK_MAX_CONTEXT=5

# 看板（M5，口径见 docs/design.md §9）
ZY_DASHBOARD_SESSION_MINUTES=30
ZY_REWORK_HOURS_PER_MISS=3.5
